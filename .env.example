# A free TMDB v4 Read Access Token: https://www.themoviedb.org/settings/api
# Server-only — attached to upstream requests inside the dev proxy (vite.config.ts)
# and the Vercel function (api/movies/[...path].ts). Never sent to the browser.
API_KEY=

# This app's own proxy path (never TMDB's URL directly) — resolved by the dev
# proxy locally and by api/movies/[...path].ts in production. Only change this
# if you rename the api/movies route.
VITE_API_BASE_URL=/api/movies
