# RestCountries API key (api.restcountries.com, Bearer auth, format rc_live_...).
# Server-only — attached to upstream requests inside the dev proxy (vite.config.ts)
# and the Vercel function (api/countries/[...path].ts). Never sent to the browser.
API_KEY=

# This app's own proxy path (never RestCountries' URL directly) — resolved by
# the dev proxy locally and by api/countries/[...path].ts in production. Only
# change this if you rename the api/countries route.
VITE_API_BASE_URL=/api/countries
